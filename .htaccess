# ============================================================================
# Jollof Living — Apache configuration (cPanel / shared hosting friendly)
#
# Upload this file INTO THE SAME FOLDER as index.php — either the document
# root (public_html/.htaccess) or a sub-folder (public_html/jollof/.htaccess).
# The rewrites are written relative to this file's own directory, so they work
# in both locations. If the site lives in a sub-folder, update the two
# absolute paths flagged with "SUB-FOLDER NOTE" below.
#
#   1. Pretty, canonical URLs (incl. the /automations/ subsidiary site)
#   2. 301 consolidation of legacy / duplicate entry points
#   3. Compression + long-lived caching (Core Web Vitals)
#   4. Hardening for files that must never be public
# ============================================================================

Options -Indexes
DirectoryIndex index.php index.html

# ----------------------------------------------------------------------------
# 1) REWRITES
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# --- Optional: force the canonical host + https. Uncomment once
#     https://www.jollofliving.com resolves with a valid certificate, so a
#     single host appears in every index. The staging domain keeps working
#     while the rules are commented out (canonical tags keep URLs consolidated).
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.jollofliving.com%{REQUEST_URI} [R=301,L]

# --- Legacy subsidiary path .../jollof-automations/* -> .../automations/*
#     (THE_REQUEST guard: internal rewrites below can never re-trigger this)
RewriteCond %{THE_REQUEST} \s/\S*/jollof-automations/?([^\s?]*)[?\s]
RewriteRule .* automations/%1 [R=301,L]

# --- Legacy root entry point .../automations.php -> .../automations/
RewriteCond %{THE_REQUEST} \s/\S*automations\.php[?\s]
RewriteRule ^automations\.php$ automations/ [R=301,L]

# --- Pretty dynamic URLs (slug pages). Canonical tags on the PHP files point
#     back at these pretty URLs, so search engines keep one copy of each page.
RewriteRule ^stay/([^/]+)/?$        stay.php?p=$1 [L,QSA]
RewriteRule ^booking/([^/]+)/?$     booking.php?p=$1 [L,QSA]
RewriteRule ^neighborhood/([^/]+)/?$ neighborhood.php?n=$1 [L,QSA]
RewriteRule ^blog/([^/]+)/?$        blog-post.php?s=$1 [L,QSA]
RewriteRule ^confirm/([^/]+)/?$     confirm.php?ref=$1 [L,QSA]

# --- Pretty static pages
RewriteRule ^(stays|experiences|neighborhoods|collections|membership|blog|reviews|help|host|about|business|giftcards|referral|app|future|map|concierge|compare|auth)/?$ $1.php [L]

# --- Jollof Automations subsite served under /automations/*
RewriteRule ^automations/?$ jollof-automations/index.php [L]
RewriteRule ^automations/(.+)$ jollof-automations/$1 [L]

# --- sitemap.xml is generated by sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ----------------------------------------------------------------------------
# 2) ERROR PAGES
# ----------------------------------------------------------------------------
# SUB-FOLDER NOTE: if the site lives at e.g. /jollof/, change this to
# ErrorDocument 404 /jollof/404.php
ErrorDocument 404 /404.php

# ----------------------------------------------------------------------------
# 3) COMPRESSION — text assets over the wire
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/vnd.ms-fontobject application/x-font-ttf font/woff2
</IfModule>

# ----------------------------------------------------------------------------
# 4) CACHING — assets are cache-busted with ?v=filemtime, so they can live long
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresByType text/css    "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html   "access plus 5 minutes"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|css|js|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# 5) HARDENING — never serve repo artifacts, dumps or dotfiles
# ----------------------------------------------------------------------------
<FilesMatch "(?i)\.(sql|zip|log|ini|sh|bak|dist|lock)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^\.git - [F]
  RewriteRule ^docs/ - [F]
</IfModule>
