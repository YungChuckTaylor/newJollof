# ============================================================================
# Jollof Living — Apache configuration (HostGator / cPanel shared hosting)
#
# Upload this file INTO THE SAME FOLDER as index.php — i.e. for the current
# staging install:  public_html/jollof/.htaccess
#
#   1. Pretty, canonical URLs (incl. the /automations/ subsidiary site)
#   2. 301 consolidation of legacy / duplicate entry points
#   3. Compression + long-lived caching (Core Web Vitals)
#   4. Hardening for files that must never be public
#
# Written for maximum compatibility: every directive that shared hosts
# sometimes reject is wrapped in <IfModule> or dual 2.2/2.4 syntax, so this
# file cannot take the site down with a 500.
# ============================================================================

# NB: deliberately NO "Options -Indexes" here — if the host's AllowOverride
# excludes Options, that single line would 500 the whole site.

DirectoryIndex index.php index.html

# ----------------------------------------------------------------------------
# 1) REWRITES (mod_rewrite is enabled on every cPanel host)
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# --- Optional: force the canonical host + https. Uncomment once
#     https://www.jollofliving.com resolves with a valid certificate.
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.jollofliving.com%{REQUEST_URI} [R=301,L]

# --- Legacy subsidiary path .../jollof-automations/* -> .../automations/*
#     (THE_REQUEST guard: internal rewrites below can never re-trigger this)
RewriteCond %{THE_REQUEST} \s/\S*/jollof-automations/?([^\s?]*)[?\s]
RewriteRule .* automations/%1 [R=301,L]

# --- Legacy root entry point .../automations.php -> .../automations/
RewriteCond %{THE_REQUEST} \s/\S*automations\.php[?\s]
RewriteRule ^automations\.php$ automations/ [R=301,L]

# --- Pretty dynamic URLs (slug pages). Canonical tags on the PHP files point
#     back at these pretty URLs, so search engines keep one copy of each page.
RewriteRule ^stay/([^/]+)/?$        stay.php?p=$1 [L,QSA]
RewriteRule ^booking/([^/]+)/?$     booking.php?p=$1 [L,QSA]
RewriteRule ^neighborhood/([^/]+)/?$ neighborhood.php?n=$1 [L,QSA]
RewriteRule ^blog/([^/]+)/?$        blog-post.php?s=$1 [L,QSA]
RewriteRule ^confirm/([^/]+)/?$     confirm.php?ref=$1 [L,QSA]

# --- Pretty static pages
RewriteRule ^(stays|experiences|neighborhoods|collections|membership|blog|reviews|help|host|about|business|giftcards|referral|app|future|map|concierge|compare|auth)/?$ $1.php [L]

# --- Jollof Automations subsite served under /automations/*
RewriteRule ^automations/?$ jollof-automations/index.php [L]
RewriteRule ^automations/(.+)$ jollof-automations/$1 [L]

# --- sitemap.xml is generated by sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ----------------------------------------------------------------------------
# 2) ERROR PAGES
# ----------------------------------------------------------------------------
# The install currently lives in the SUB-FOLDER /jollof/ — keep the prefix.
# If you later move the site to the document root, change this to /404.php.
ErrorDocument 404 /jollof/404.php

# ----------------------------------------------------------------------------
# 3) COMPRESSION — text assets over the wire
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# 4) CACHING — assets are cache-busted with ?v=filemtime, so they can live long
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresByType text/css    "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html   "access plus 5 minutes"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|css|js|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# 5) HARDENING — never serve repo artifacts, dumps or dotfiles.
#    Dual syntax: Apache 2.4 (Require) with 2.2 fallback (Order/Deny).
# ----------------------------------------------------------------------------
<FilesMatch "(?i)\.(sql|zip|log|ini|sh|bak|dist|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^\.git - [F]
  RewriteRule ^docs/ - [F]
</IfModule>
